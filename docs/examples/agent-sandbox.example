# ============================================================
# .agent-sandbox —— 設定檔範例（每行 key = value，重複 key 視為清單）
#
# 用法：
#   cp docs/examples/agent-sandbox.example ~/你的專案/.agent-sandbox
#   取消你需要那幾行的註解、改成你的路徑/變體，在該目錄跑 agent-sandbox。
#
# 每個 [段名] 後面標了作用範圍：
#   全域＋專案皆可 → 專案根、agent-sandbox 工具目錄兩處放都生效
#   僅專案層生效   → 只能放專案根；放工具目錄會被 ⚠️ 略過
#
# 段標頭獨佔一行（可帶行內註解，如下方範例）。容器 git 身分不在這裡，是
# home/<identity>/.gitconfig（標準 git 檔），見 README「多身分」段。
#
# 要不要進版控：專案層用相對路徑（../backend）可以 commit 分享隊友（本
# repo .gitignore 預設擋掉 .agent-sandbox，要分享得手動放行）；用絕對／
# ~ 路徑或全域層，就是你自己機器的本機狀態，別進版控。
#
# 完整說明見 README「額外掛載」段與 docs/design/agent-sandbox.md。
# ============================================================

[mount]  # 全域＋專案皆可：兩層 + CLI -m 全部疊加
# path = <host>[:<container>][:ro]，一行一條。container 省略預設
# /workspace/<host basename>；ro 只能當第三段。細節見 README。

# inherit-global = false                 # 這個專案不要繼承全域 [mount]
# path = ../backend                      # 掛到 /workspace/backend
# path = ../some/long/path/backend:api   # 指定別名，掛到 /workspace/api
# path = ../shared:shared:ro             # 唯讀共用
# path = ../shared::ro                   # 唯讀、不改名（中間空著＝容器路徑用預設 /workspace/shared）
# path = ~/data/dump:/data/dump:ro       # 掛到 /workspace 以外（會印 ⚠️ 警告，自負其責）

[image]  # 僅專案層生效（放全域檔會被 ⚠️ 略過）
# 這個專案固定要跑的 base/addon。--base/--addon 蓋過它。
#
# base = claude          # 預設就是 claude，通常不用寫
# addon = openspec       # 可重複多行依序疊層

[identity]  # 僅專案層生效（放全域檔會被 ⚠️ 略過）
# 這個專案固定要用的身分。--identity 蓋過它。
#
# identity = ops         # 例：管雲端主機的專案固定用 ops 身分

# ============================================================
# 想設定全域 [mount]（每個專案都會掛的共用資料夾）？把 [mount] 段複製到
# 「agent-sandbox 工具目錄」自己的 .agent-sandbox（不是專案根）即可，
# 路徑須絕對/~。⚠️ 全域 mount 每個 sandbox 都掛，建議盡量加 :ro。
# ============================================================
